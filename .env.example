# Copy to .env. Models only: the guardrail and the API key are created by the
# stack and come back as outputs.

# The bot's default model, and the stronger one a request gets with
# `x-model-tier: frontier`. Keep them genuinely different: the demo's point is
# that the cheaper tier folds faster.
BOT_MODEL_ID=deepseek.v3-v1:0
BOT_MODEL_ID_PREMIUM=global.anthropic.claude-sonnet-4-6

# Scores the bot's reply against the checks. Cheap and fast is fine.
JUDGE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# All three are required before the first deploy, because the stack grants IAM
# for exactly these models. No defaults in the code on purpose.

# Optional. `cdk deploy` uses your AWS profile's account and Region. Set these
# only to pin somewhere else. The Region needs Bedrock AgentCore Runtime.
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=eu-west-2

# Optional. Only if you deploy under a different stack name.
# STACK_NAME=GuardrailsDemo
