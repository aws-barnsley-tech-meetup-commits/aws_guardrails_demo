# Base URL of the deployed API (the ApiUrl stack output). No trailing slash needed.
VITE_API_URL=https://example.execute-api.eu-west-1.amazonaws.com

# The shared API key for POST /c1/attack. Optional here, but the deployed API
# answers 401 without it. Vite inlines VITE_* values into the bundle, so only
# use this for a local demo, never for a build you publish.
VITE_API_KEY=

# true = answer from built-in sample data, no API calls. For rehearsing the UI.
VITE_MOCK=false
